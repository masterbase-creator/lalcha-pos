# Local development works without any of these. Production must set the ones marked required.

# required in production
# NODE_ENV=production
# DATABASE_URL=postgres://lalcha_app:change-me@localhost:5432/lalcha
# ADMIN_DATABASE_URL=postgres://postgres:change-me@localhost:5432/lalcha
# PLATFORM_DATABASE_URL=postgres://lalcha_platform:change-me@localhost:5432/lalcha
# BASE_DOMAIN=example.com
# OTP_PEPPER=long-random-value

# superadmin panel: served only on ADMIN_HOST, sign-in by emailed code to these addresses only.
# Also put Cloudflare Access (Zero Trust) in front of ADMIN_HOST so the page can't be reached without it.
# ADMIN_HOST=admin.example.com
# PLATFORM_ADMIN_EMAILS=you@example.com,partner@example.com

# outgoing mail for login codes (required in production)
# SMTP_URL=smtps://no-reply%40example.com:password@mail.example.com:465
# MAIL_FROM="Lalcha POS <hello@example.com>"

# optional: send login codes through a relay with a good reputation (e.g. Cloudflare Email Service),
# from a subdomain set up for it. Without a password, codes go through SMTP_URL.
# CODES_SMTP_PASSWORD=
# CODES_SMTP_HOST=smtp.mx.cloudflare.net
# CODES_SMTP_PORT=465
# CODES_SMTP_USER=api_token
# CODES_MAIL_FROM="Lalcha POS <hello@notification.example.com>"

# company inbox in the superadmin panel: your mail server posts incoming mail to
# https://<BASE_DOMAIN>/v1/mail/inbound?k=<MAIL_WEBHOOK_TOKEN>. Off until the token is set.
# MAIL_DOMAIN=example.com
# MAILBOXES=hello,support,billing
# MAIL_WEBHOOK_TOKEN=long-random-value

# files: product photos, inbox attachments and encrypted nightly backups go to a private
# Cloudflare R2 bucket when these are set; without them, photos stay in apps/api/public.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lalcha
# Backups are encrypted with this before upload. Keep a copy somewhere safe: without it they can't be read.
# BACKUP_PASSPHRASE=long-random-value
# BACKUP_DAILY_DAYS=14
# BACKUP_MONTHLY_MONTHS=12
# ATTACHMENT_RETENTION_DAYS=730

# subscription payments are switched off until both are set
# BILLING_BKASH=01XXXXXXXXX
# BILLING_NAGAD=01XXXXXXXXX

# optional
# public demo store at demo.<BASE_DOMAIN>; reset it hourly with: pnpm --filter @lalcha/api demo:reset
# DEMO_SUBDOMAIN=demo
# API_PORT=8787
# HOST=127.0.0.1
