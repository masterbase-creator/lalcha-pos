# Local development works without any of these. Production must set the ones marked required.

# required in production
# NODE_ENV=production
# DATABASE_URL=postgres://lalcha_app:change-me@localhost:5432/lalcha
# ADMIN_DATABASE_URL=postgres://postgres:change-me@localhost:5432/lalcha
# PLATFORM_DATABASE_URL=postgres://lalcha_platform:change-me@localhost:5432/lalcha
# BASE_DOMAIN=example.com
# OTP_PEPPER=long-random-value
# PLATFORM_KEY=long-random-value

# subscription payments are switched off until both are set
# BILLING_BKASH=01XXXXXXXXX
# BILLING_NAGAD=01XXXXXXXXX

# optional
# API_PORT=8787
# HOST=127.0.0.1
